# ─────────────────────────────────────────────────────────────
# ITAS API — variables de entorno de referencia (FASE 3)
#
# Copia este archivo a backend/.env y rellena los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ─── Base de datos (Neon / PostgreSQL) ───────────────────────
# Cadena asyncpg; DB_SSL fuerza el modo SSL ("require" | "disable" | vacío)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
DB_SSL=require

# ─── Seguridad ──────────────────────────────────────────────
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA-ESTA-CLAVE-ALEATORIA-LARGA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bloqueo de cuenta por fuerza bruta
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=30

# true SOLO en desarrollo: desactiva rate limiting, CSRF y TrustedHost
DEBUG=true

# ─── Límites de tamaño (FASE 3) ─────────────────────────────
# Tamaño máximo de una imagen decodificada (base64 → bytes)
MAX_IMAGE_BYTES=10485760
# Tamaño máximo de una petición HTTP completa (deja pasar la imagen en base64)
MAX_REQUEST_BYTES=15728640

# ─── CORS y hosts permitidos (FASE 3) ───────────────────────
# Listas en formato JSON, editables sin tocar código.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","https://pedidos-ima.vercel.app"]
ALLOWED_HOSTS=["localhost","127.0.0.1","itas-backend","pedidos-ima.vercel.app","*.vercel.app"]

# ─── Redis (FASE 3) ─────────────────────────────────────────
# En Docker Compose: redis://redis:6379
# En local sin Redis el backend funciona con fallback en memoria.
REDIS_URL=redis://localhost:6379

# ─── Cloudinary (subida de imágenes) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
